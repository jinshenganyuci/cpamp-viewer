CPAMP_VIEWER_VERSION=2.6.0
VIEWER_PUBLIC_ACCESS=true
TZ=Asia/Shanghai
CPAMP_VIEWER_BIND=127.0.0.1
CPAMP_VIEWER_PORT=18417
CPAMP_VIEWER_V2_BIND=0.0.0.0
CPAMP_VIEWER_V2_PORT=18418
CLIPROXY_NETWORK=bridge
CPAMP_BASE_URL=https://cpamp.example.com
# Optional additional Sub2API source (use compose.sub2api.yaml).
# SUB2API_BASE_URL=http://sub2api:8080
# SUB2API_ADMIN_API_KEY_PATH=./secrets/sub2api_admin_api_key.txt
VIEWER_SECURE_COOKIES=false
VIEWER_SESSION_TTL=12h
VIEWER_MAX_ANALYTICS_RANGE=8784h
VIEWER_MAX_EVENTS_PAGE=200
CPAMP_ADMIN_KEY_PATH=./secrets/cpamp_admin_key.txt
VIEWER_SESSION_SECRET_PATH=./secrets/viewer_session_secret.txt

# Optional: publish all plugin binding names and quotas through existing CPAMP.
# Add the same variable to your Compose service environment (see README).
# ACCESS_GUARD_PUBLIC_ALL=true
# Or select entries without a separate file (mutually exclusive with PUBLIC_ALL):
# ACCESS_GUARD_PUBLIC_KEYS={"keys":[{"binding_id":"native-key-example","name":"Example"}]}

# Advanced optional direct CPA connection overlay:
# ACCESS_GUARD_BASE_URL=http://cli-proxy-api:8317
# ACCESS_GUARD_MANAGEMENT_KEY_PATH=./secrets/access_guard_management_key.txt
# ACCESS_GUARD_PUBLIC_KEYS_PATH=./secrets/access_guard_public_keys.json
